{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e0cfe4ec92444b1fb66169816fad4bdf",
    "m_Title": "Looks scarier than it is",
    "m_Content": "Changed shader to be Unlit for finer toggle control. Below nodes just add lighting features if its toggle is enabled, but the actual math is identical to in-class (Lecture 4 I believe).\n\n^ aside from ambient lighting, which is multiplied by the base color and added to the final color. The in-class example simply multiplied the final color by the ambient color, resulting in shadowed fragments not receiving ambient light (because their lambert result is zero).\nAlso added a weight for NdotL contribution, since it looks kinda weird on flat grass",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1936.0,
        "y": 164.0,
        "width": 504.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

